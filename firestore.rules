rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔥 PRODUCTION SECURE RULES FOR NUTRIDECIDE

    // Helper: Check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles – only owner can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow admin to read all users
      allow read: if isAdmin();
      
      // Scan history subcollection
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Custom products subcollection (user's own pending entries)
      match /custom_products/{barcode} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Pending products – any authenticated user can submit, admins can read/delete
    match /pending_products/{barcode} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }

    // Global products – all authenticated users can read, only admins can write
    match /global_products/{barcode} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Legacy profiles collection (backward compat)
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
